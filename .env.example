# Application
APP_NAME=Enterprise Agentic Research Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# External integration tests
RUN_LIVE_TESTS=false

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Tavily
TAVILY_API_KEY=

# PostgreSQL
POSTGRES_USER=research_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=research_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=private_documents

# LLM provider
LLM_PROVIDER=anthropic

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024
