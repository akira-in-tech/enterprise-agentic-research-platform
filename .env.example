# Application
APP_NAME=Enterprise Agentic Research Platform
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
# External integration tests
RUN_LIVE_TESTS=false

# API server
API_HOST=127.0.0.1
API_PORT=8000

# Private source-document uploads
DOCUMENT_STORAGE_ROOT=uploads
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_S3_BUCKET=
DOCUMENT_MAX_UPLOAD_BYTES=10000000

# Docker Compose frontend
FRONTEND_PORT=3000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Tavily
TAVILY_API_KEY=

# PostgreSQL
POSTGRES_USER=research_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=research_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://research_user:change_me@localhost:5432/research_platform
DATABASE_ECHO=false
RESEARCH_WORKER_LEASE_TTL_SECONDS=30
RESEARCH_WORKER_HEARTBEAT_SECONDS=10

# Redis cache, idempotency and short-lived coordination
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_RESEARCH_RESULT_TTL_SECONDS=900
REDIS_RESEARCH_IDEMPOTENCY_TTL_SECONDS=86400
REDIS_RESEARCH_IDEMPOTENCY_LOCK_TTL_SECONDS=300
REDIS_RESEARCH_RATE_LIMIT_REQUESTS=20
REDIS_RESEARCH_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_RESEARCH_PROGRESS_TTL_SECONDS=3600

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=private_document_chunks

# MinIO backing store used by local Milvus Compose service
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Vector store provider
VECTOR_STORE_PROVIDER=milvus

# LLM provider
LLM_PROVIDER=anthropic

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIMENSIONS=1024

# Cloud-compatible embeddings
EMBEDDING_PROVIDER=ollama
AWS_REGION=us-west-2
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
MCP_ENDPOINT=
MCP_SERVER_NAME=evident-reference
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
