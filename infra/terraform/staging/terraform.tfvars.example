aws_region                = "us-west-2"
project_name              = "evident-research"
environment               = "staging"
vpc_cidr                  = "10.24.0.0/16"
availability_zone_count   = 2
monthly_budget_limit_usd  = 25
budget_notification_email = "replace-with-your-email@example.com"
database_name              = "research_platform"
database_username          = "research_admin"
database_instance_class    = "db.t4g.micro"
database_allocated_storage_gib = 20
cache_node_type                 = "cache.t4g.micro"
api_image_tag                   = "replace-with-git-sha"
frontend_image_tag              = "replace-with-git-sha"
application_desired_count       = 0
anthropic_model                 = "replace-with-supported-model-id"
milvus_uri                      = "https://replace-with-managed-milvus-endpoint"
milvus_collection               = "private_document_chunks"
