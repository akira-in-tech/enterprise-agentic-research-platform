{
  "name": "evident-research-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@phosphor-icons/vue": "latest",
    "@tanstack/vue-query": "^5.101.4",
    "pinia": "^4.0.2",
    "vue": "latest",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "latest",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "overrides": {
    "vue-router": {
      "vite": "$vite"
    }
  }
}
